{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-respond/cli/validate.json",
  "title": "validate --json",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "enum": [
              "forgectl",
              "agent-spawn",
              "pr-comment",
              "wtctl",
              "git",
              "jobsctl",
              "claude-session"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "found": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "minimum": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "tool",
          "required",
          "found",
          "minimum",
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "config",
              "state",
              "dependencies",
              "sandbox",
              "cron_path",
              "credentials"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "code": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "skipped": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "code"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "ok",
    "dependencies",
    "checks",
    "warnings"
  ],
  "additionalProperties": false
}
