{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-respond/cli/show.json",
  "title": "show --json",
  "description": "One object in full: a PR, a round or a pending confirmation, told apart by object_type.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "object_type": {
          "const": "pr"
        },
        "pr": {
          "$ref": "../defs.json#/$defs/pr_state"
        },
        "rounds": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/round"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/comment_record"
          }
        }
      },
      "required": [
        "object_type",
        "pr",
        "rounds",
        "comments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "object_type": {
          "const": "round"
        },
        "round": {
          "$ref": "../defs.json#/$defs/round"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/comment_record"
          }
        }
      },
      "required": [
        "object_type",
        "round",
        "comments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "object_type": {
          "const": "pending"
        },
        "pending": {
          "$ref": "../defs.json#/$defs/pending"
        },
        "diff": {
          "type": "string",
          "description": "The stored diff, sanitized.",
          "x-untrusted": true
        }
      },
      "required": [
        "object_type",
        "pending",
        "diff"
      ],
      "additionalProperties": false
    }
  ]
}
