{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-respond/cli/cron-install.json",
  "title": "cron install --json",
  "description": "block is the managed block as a list of lines, as written (or that would be written).",
  "type": "object",
  "properties": {
    "action": {
      "const": "install"
    },
    "dry_run": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "replaced": {
      "type": "boolean"
    },
    "block": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 16
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "action",
    "dry_run",
    "changed",
    "replaced",
    "block"
  ],
  "additionalProperties": false
}
