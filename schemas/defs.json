              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 65536,
          "description": "Comment text, sanitized.",
          "x-untrusted": true
        }
      },
      "required": [
        "id",
        "author_id",
        "eligible",
        "reason",
        "state",
        "edited",
        "thread_id",
        "path",
        "line",
        "body"
      ],
      "additionalProperties": false
    }
  }
