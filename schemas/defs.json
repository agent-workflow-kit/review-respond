{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-respond/defs.json",
  "title": "review-respond shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the CLI, hook, artifact, gate-input, audit and log schemas. config.json embeds its own copies.",
  "$defs": {
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:[.][a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]{1,5})?$",
      "description": "Lowercase host, optional :port."
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:[.][a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]{1,5})?(?:/(?![.][.]?(?:/|$))[A-Za-z0-9._-]+)+$",
      "description": "host/<full project path>."
    },
    "pr": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:[.][a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]{1,5})?(?:/(?![.][.]?(?:/|#))[A-Za-z0-9._-]+)+#[1-9][0-9]{0,9}$",
      "description": "Canonical PR form host/<full project path>#N."
    },
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:/_=.+-]{0,255}$",
      "description": "An opaque id issued by a sibling tool or a host (agent, throwaway, thread, comment)."
    },
    "comment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:/_=.+-]{0,255}$",
      "description": "forgectl's full comment id, for example gh:rc:<node id>."
    },
    "thread_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:/_=.+-]{0,255}$",
      "description": "forgectl's thread id."
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "agent-spawn's agent id, opaque."
    },
    "throwaway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "wtctl's throwaway id, opaque."
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]{1,6})?Z$",
      "description": "UTC timestamp, YYYY-MM-DDTHH:MM:SS[.ffffff]Z."
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:0|[0-9]+(?:ms|s|m|h|d))$",
      "description": "0 or an integer and a unit (ms, s, m, h, d)."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "pending_id": {
      "type": "string",
      "pattern": "^rp-[a-z2-7]{8}$",
      "description": "rp- plus 8 lowercase base32 characters."
    },
    "round_id": {
      "type": "string",
      "pattern": "^rd-[a-z2-7]{8}$",
      "description": "rd- plus 8 lowercase base32 characters."
    },
    "job_id": {
      "type": "string",
      "pattern": "^jb-[a-z2-7]{8}$",
      "description": "jobsctl's job id."
    },
    "actor": {
      "type": "string",
      "pattern": "^(?:human|auto):[A-Za-z0-9._@-]{1,64}$"
    },
    "actor_class": {
      "enum": [
        "human",
        "auto"
      ]
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,128}$"
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision_id"
      },
      "maxItems": 16
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}=[A-Za-z0-9._:/#@+=,-]{0,256}$",
      "description": "key=value."
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      },
      "uniqueItems": true,
      "maxItems": 8,
      "description": "pr, round or pending, owner and repo labels as key=value strings."
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#=+-]{1,256}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#=+-]{1,256}$",
      "description": "<object id>-<hook>-<n>, the outbox deduplication id."
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*/$)(?!.*//)(?!(?:.*/)?[.][.]?(?:/|$))[A-Za-z0-9._*?/:@+-]+$",
      "description": "A path glob (review-watch's path matching): * and ? within a segment, a ** segment matches zero or more whole segments."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(?:.*/)?[.][.]?(?:/|$))(?!(?:.*/)?[.][gG][iI][tT](?:/|$)).+$",
      "description": "A relative, normalized repo path with no .. or .git component (case-folded). Untrusted: chosen by the agent.",
      "x-untrusted": true
    },
    "login": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._@-]+$"
    },
    "account_entry": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]{1,5})?:[A-Za-z0-9._@=+-]{1,128}$",
      "description": "<host>:<account id>."
    },
    "policy_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "A closed lowercase code."
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Untrusted: a branch name as reported by forgectl.",
      "x-untrusted": true
    },
    "pr_state_name": {
      "enum": [
        "idle",
        "settling",
        "queued",
        "running",
        "pending",
        "escalated",
        "limit",
        "closed"
      ]
    },
    "round_state": {
      "enum": [
        "queued",
        "running",
        "pending",
        "escalated",
        "failed",
        "canceled",
        "expired",
        "closed"
      ]
    },
    "pending_state": {
      "enum": [
        "pending",
        "pushing",
        "pushed",
        "posting",
        "done",
        "rejected",
        "expired",
        "closed"
      ]
    },
    "comment_state": {
      "enum": [
        "seen",
        "delivered",
        "handled",
        "deleted"
      ]
    },
    "ineligible_reason": {
      "enum": [
        "own",
        "bot",
        "no_access",
        "unknown_access",
        "resolved",
        "closed"
      ]
    },
    "failure_reason": {
      "enum": [
        "artifact_missing",
        "artifact_invalid",
        "skill_not_loaded",
        "implicit_done",
        "empty_result",
        "agent_failed",
        "timeout",
        "launch_failed",
        "refused",
        "job_lost",
        "diff_failed"
      ]
    },
    "refusal_reason": {
      "enum": [
        "live",
        "pending_exists",
        "round_limit",
        "remote_moved",
        "diff_changed",
        "stale_head",
        "sensitive_paths",
        "expired",
        "not_pending",
        "ineligible",
        "pr_closed",
        "held",
        "repo_config_changed"
      ]
    },
    "attention_reason": {
      "enum": [
        "escalated",
        "failed",
        "round_limit",
        "pending_expired",
        "remote_moved",
        "push_failed",
        "reply_failed",
        "job_lost",
        "ineligible_comment",
        "pr_closed",
        "teardown_refused"
      ]
    },
    "object_type": {
      "enum": [
        "round",
        "pending",
        "pr"
      ]
    },
    "trigger": {
      "enum": [
        "check",
        "respond"
      ]
    },
    "gate_decision": {
      "enum": [
        "allow",
        "deny",
        "escalate"
      ]
    },
    "outcome": {
      "enum": [
        "agree",
        "disagree"
      ]
    },
    "sandbox_level": {
      "enum": [
        "required",
        "preferred",
        "off"
      ]
    },
    "pending_action": {
      "enum": [
        "push_and_reply",
        "reply"
      ],
      "description": "push_and_reply: a record with changed or deleted files; reply: a replies-only record."
    },
    "reply_status": {
      "enum": [
        "pending",
        "posted",
        "skipped",
        "failed"
      ]
    },
    "reply_skip_reason": {
      "enum": [
        "comment_deleted",
        "thread_resolved",
        "dropped"
      ]
    },
    "ci_state": {
      "enum": [
        "passing",
        "failing",
        "pending",
        "none",
        "unknown"
      ]
    },
    "hook_name": {
      "enum": [
        "pre-round",
        "pre-push",
        "post-pending",
        "post-attention",
        "post-confirm"
      ]
    },
    "error_code": {
      "enum": [
        "usage",
        "config_invalid",
        "not_found",
        "ambiguous",
        "vetoed",
        "escalated",
        "confirmation_required",
        "refused",
        "failed",
        "nothing_to_respond",
        "tool_missing",
        "tool_too_old",
        "identity_missing",
        "throwaway_missing",
        "version_skew",
        "push_failed",
        "state_unsafe",
        "internal"
      ]
    },
    "error_reason": {
      "enum": [
        "live",
        "pending_exists",
        "round_limit",
        "remote_moved",
        "diff_changed",
        "stale_head",
        "sensitive_paths",
        "expired",
        "not_pending",
        "ineligible",
        "pr_closed",
        "held",
        "repo_config_changed",
        "all_hosts_failed",
        "human_required",
        "usage",
        "tool_missing",
        "tool_too_old",
        "push_failed",
        "reply_failed",
        "lower_failed",
        "version_skew",
        "throwaway_missing",
        "identity_missing"
      ],
      "description": "Exit 20 refusal reasons plus the reasons of exits 2 and 12."
    },
    "lower_error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 4096,
          "x-untrusted": true
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "description": "A sibling tool's error object, passed through."
    },
    "error_body": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 4096,
          "x-untrusted": true
        },
        "reason": {
          "$ref": "#/$defs/error_reason"
        },
        "details": {
          "type": "object",
          "description": "Ids, enums and counts; free object."
        },
        "lower_error": {
          "$ref": "#/$defs/lower_error"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "diff_stats": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/$defs/policy_name"
        },
        "decision_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/decision_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "oneOf": [
            {
              "$ref": "#/$defs/gate_decision"
            },
            {
              "type": "null"
            }
          ]
        },
        "enforced": {
          "type": "boolean"
        },
        "outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "policy",
        "decision_id",
        "decision",
        "enforced",
        "outcome",
        "checked_at"
      ],
      "additionalProperties": false,
      "description": "A gate record: the policy, the decision id, the decision, the enforced flag and any human outcome filed."
    },
    "failure": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/failure_reason"
        },
        "detail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1024,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reason",
        "detail"
      ],
      "additionalProperties": false
    },
    "round": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/round_id"
        },
        "pr": {
          "$ref": "#/$defs/pr"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/round_state"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "agent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/agent_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/job_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "comment_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment_id"
          },
          "uniqueItems": true
        },
        "failure": {
          "oneOf": [
            {
              "$ref": "#/$defs/failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "started": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "pr",
        "number",
        "attempt",
        "state",
        "head_sha",
        "agent_id",
        "job_id",
        "comment_ids",
        "failure",
        "started",
        "ended",
        "warnings"
      ],
      "additionalProperties": false
    },
    "pr_state": {
      "type": "object",
      "properties": {
        "pr": {
          "$ref": "#/$defs/pr"
        },
        "repo": {
          "$ref": "#/$defs/repo_id"
        },
        "state": {
          "$ref": "#/$defs/pr_state_name"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "head_ref": {
          "$ref": "#/$defs/branch"
        },
        "base_ref": {
          "$ref": "#/$defs/branch"
        },
        "is_fork": {
          "type": "boolean"
        },
        "base_agent": {
          "oneOf": [
            {
              "$ref": "#/$defs/agent_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "unhandled": {
          "type": "integer",
          "minimum": 0
        },
        "ineligible": {
          "type": "integer",
          "minimum": 0
        },
        "edited": {
          "type": "integer",
          "minimum": 0
        },
        "pending_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/pending_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "pr",
        "repo",
        "state",
        "head_sha",
        "head_ref",
        "base_ref",
        "is_fork",
        "base_agent",
        "rounds",
        "unhandled",
        "ineligible",
        "edited",
        "pending_id",
        "updated"
      ],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "properties": {
        "comment_id": {
          "$ref": "#/$defs/comment_id"
        },
        "thread_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/thread_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 65536,
          "description": "Agent-written reply, sanitized.",
          "x-untrusted": true
        },
        "dedupe_key": {
          "$ref": "#/$defs/dedupe_key"
        },
        "status": {
          "$ref": "#/$defs/reply_status"
        },
        "status_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/reply_skip_reason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "comment_id",
        "thread_id",
        "body",
        "dedupe_key",
        "status",
        "status_reason"
      ],
      "additionalProperties": false
    },
    "pending": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/pending_id"
        },
        "pr": {
          "$ref": "#/$defs/pr"
        },
        "repo": {
          "$ref": "#/$defs/repo_id"
        },
        "round": {
          "$ref": "#/$defs/round_id"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "head_ref": {
          "$ref": "#/$defs/branch"
        },
        "base_ref": {
          "$ref": "#/$defs/branch"
        },
        "agent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/agent_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "throwaway_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/throwaway_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "deleted_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "commit_message": {
          "type": "string",
          "maxLength": 4096,
          "description": "Agent-written commit message, sanitized.",
          "x-untrusted": true
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reply"
          },
          "maxItems": 1000
        },
        "diff_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff_stats": {
          "$ref": "#/$defs/diff_stats"
        },
        "sensitive_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "gate": {
          "oneOf": [
            {
              "$ref": "#/$defs/gate"
            },
            {
              "type": "null"
            }
          ]
        },
        "edited": {
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/pending_state"
        },
        "created": {
          "$ref": "#/$defs/ts"
        },
        "expires": {
          "$ref": "#/$defs/ts"
        }
      },
      "required": [
        "id",
        "pr",
        "repo",
        "round",
        "head_sha",
        "head_ref",
        "base_ref",
        "agent_id",
        "throwaway_id",
        "changed_files",
        "deleted_files",
        "commit_message",
        "replies",
        "diff_sha256",
        "diff_stats",
        "sensitive_paths",
        "gate",
        "edited",
        "state",
        "created",
        "expires"
      ],
      "additionalProperties": false,
      "description": "A pending confirmation. Free text appears only in fields marked x-untrusted."
    },
    "pending_row": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/pending_id"
        },
        "tool": {
          "const": "review-respond"
        },
        "action": {
          "$ref": "#/$defs/pending_action"
        },
        "target": {
          "$ref": "#/$defs/pr"
        },
        "created": {
          "$ref": "#/$defs/ts"
        },
        "summary": {
          "type": "string",
          "maxLength": 256,
          "description": "A fixed phrase with counts, never agent text."
        },
        "expires": {
          "$ref": "#/$defs/ts"
        },
        "state": {
          "$ref": "#/$defs/pending_state"
        }
      },
      "required": [
        "id",
        "tool",
        "action",
        "target",
        "created",
        "summary",
        "expires",
        "state"
      ],
      "additionalProperties": false
    },
    "comment_record": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/comment_id"
        },
        "author_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-untrusted": true
        },
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/ineligible_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/comment_state"
        },
        "edited": {
          "type": "boolean"
        },
        "thread_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/thread_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
