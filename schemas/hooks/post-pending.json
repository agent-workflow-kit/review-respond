{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-respond/hooks/post-pending.json",
  "title": "post-pending hook payload (stdin)",
  "description": "A pending confirmation was recorded. At least once; deduplicate by event_id. summary is a fixed phrase with counts, never agent text.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "review-respond"
    },
    "hook": {
      "const": "post-pending"
    },
    "object_type": {
      "const": "pending"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/pending_id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "pending_id": {
      "$ref": "../defs.json#/$defs/pending_id"
    },
    "action": {
      "$ref": "../defs.json#/$defs/pending_action"
    },
    "event": {
      "const": "recorded"
    },
    "files_changed": {
      "type": "integer",
      "minimum": 0
    },
    "files_deleted": {
      "type": "integer",
      "minimum": 0
    },
    "additions": {
      "type": "integer",
      "minimum": 0
    },
    "deletions": {
      "type": "integer",
      "minimum": 0
    },
    "reply_count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "maxLength": 256
    },
    "expires": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "dedupe_key": {
      "$ref": "../defs.json#/$defs/dedupe_key"
    },
    "reads_third_party": {
      "type": "boolean"
    },
    "tainted": {
      "type": "boolean"
    }
  },
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "event_id",
    "pending_id",
    "action",
    "event",
    "files_changed",
    "files_deleted",
    "additions",
    "deletions",
    "reply_count",
    "summary",
    "expires",
    "dedupe_key",
    "reads_third_party",
    "tainted"
  ],
  "additionalProperties": false
}
