{
  "prog": "claude-session",
  "version": "0.45.2",
  "source": "claude-session docs/interface.md at v0.45.2: kinds, Global flags (flags follow the command; only --version may precede it). Only the commands in review-respond's Dependencies table. A leading --json is refused.",
  "globals_before_command": false,
  "duplicate_globals": "error",
  "patterns": {
    "kind": "^[a-z0-9][a-z0-9_-]{0,63}$",
    "repo": "^[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._-]+)+$",
    "nonempty": "^.+$"
  },
  "global_flags": {
    "--json": {},
    "--config": {"arity": 1, "pattern": "nonempty"},
    "--verbose": {},
    "--quiet": {},
    "--yes": {}
  },
  "rules": [{"exclusive": ["--verbose", "--quiet"]}],
  "commands": {
    "kinds": {
      "flags": {
        "--kind": {"arity": 1, "pattern": "kind"},
        "--repo": {"arity": 1, "pattern": "repo"}
      }
    }
  }
}
