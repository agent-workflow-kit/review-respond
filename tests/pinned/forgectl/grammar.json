{
  "prog": "forgectl",
  "version": "0.55.2",
  "source": "forgectl docs/interface.md at v0.55.2: Commands, Global flags, Identifiers, Exit codes. Only the commands in review-respond's Dependencies table. Value grammars follow forgectl's identifiers at that tag (host port 1..65535, no '.' or '..' project segments, no leading '-' owner, logins as GitHub or GitLab define them, a positive --limit up to 1000 with leading zeros allowed, a positive --updated-since duration or an RFC 3339 time).",
  "globals_before_command": true,
  "duplicate_globals": "error",
  "patterns": {
    "pr": "^(?:https://[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/(?:(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+/)+(?:-/)?(?:pull|merge_requests)/[1-9][0-9]{0,9}(?:/[A-Za-z0-9._-]+)*/?|[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/(?!-)(?:(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+/)*(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+#[1-9][0-9]{0,9})$",
    "repo": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/(?!-)(?:(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+/)*(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+$",
    "host": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
    "login": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,38}(?:\\[bot\\])?|[A-Za-z0-9_]|[A-Za-z0-9_.][A-Za-z0-9_.-]{0,253}[A-Za-z0-9_-])$",
    "sha": "^[0-9a-fA-F]{40}$",
    "duration": "^(?=[0-9.]*[1-9])[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d)?$",
    "limit": "^[0-9]{1,4}$",
    "time": "^(?:(?=[0-9.]*[1-9])[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d)?|[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2}))$",
    "nonempty": "^.+$"
  },
  "global_flags": {
    "--json": {},
    "--config": {"arity": 1, "pattern": "nonempty"},
    "--verbose": {},
    "--quiet": {},
    "--timeout": {"arity": 1, "pattern": "duration", "max_seconds": 3153600000}
  },
  "rules": [{"exclusive": ["--verbose", "--quiet"]}],
  "commands": {
    "prs": {
      "flags": {
        "--repo": {"arity": 1, "pattern": "repo"},
        "--host": {"arity": 1, "pattern": "host"},
        "--author": {"arity": 1, "pattern": "login"},
        "--review-requested-from": {"arity": 1, "pattern": "login"},
        "--state": {"arity": 1, "choices": ["open", "closed", "merged", "all"]},
        "--draft": {},
        "--no-draft": {},
        "--updated-since": {"arity": 1, "pattern": "time"},
        "--limit": {"arity": 1, "pattern": "limit", "range": [1, 1000]},
        "--query": {"arity": 1},
        "--default-query": {}
      },
      "rules": [
        {"when_absent": ["--repo"], "requires_any": ["--author", "--review-requested-from"]},
        {"exclusive": ["--repo", "--host"]},
        {"exclusive": ["--draft", "--no-draft"]},
        {"exclusive": ["--query", "--default-query"]}
      ]
    },
    "show": {"positionals": [{"name": "pr", "pattern": "pr"}]},
    "comments": {"positionals": [{"name": "pr", "pattern": "pr"}]},
    "access": {"positionals": [{"name": "repo", "pattern": "repo"}, {"name": "user", "pattern": "login"}]},
    "whoami": {
      "flags": {
        "--host": {"arity": 1, "pattern": "host"}
      }
    },
    "compare": {
      "positionals": [{"name": "pr", "pattern": "pr"}],
      "flags": {
        "--from": {"arity": 1, "pattern": "sha", "required": true},
        "--to": {"arity": 1, "pattern": "sha", "required": true},
        "--no-diff": {}
      }
    }
  }
}
