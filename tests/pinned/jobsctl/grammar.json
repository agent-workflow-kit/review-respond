{
  "prog": "jobsctl",
  "version": "0.32.1",
  "source": "jobsctl docs/interface.md at v0.32.1: Commands (add, show, cancel, resolve), Selectors, Human-only flags, Global flags. Only the commands in review-respond's Dependencies table. Global flags after the command only (conservative: the pinned doc does not say they may precede it).",
  "globals_before_command": false,
  "duplicate_globals": "error",
  "patterns": {
    "job": "^(?:jb-)?[a-z2-7]{4,8}$",
    "queue": "^[a-z0-9][a-z0-9_-]{0,63}$",
    "label": "^[a-z0-9][a-z0-9_.-]{0,63}=[A-Za-z0-9._:/#@+=,-]{0,256}$",
    "actor": "^(?:human|auto):[A-Za-z0-9._@-]{1,64}$",
    "decision_id": "^[A-Za-z0-9._:@/-]{1,128}$",
    "duration": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d)?)$",
    "duration_or_none": "^(?:none|[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d)?)$",
    "env": "^[A-Za-z_][A-Za-z0-9_]*=.*$",
    "envname": "^[A-Za-z_][A-Za-z0-9_]*$",
    "priority": "^-?[0-9]{1,4}$",
    "retries": "^(?:[0-9]|[1-9][0-9]|100)$",
    "abspath": "^/.*$",
    "posint": "^[1-9][0-9]*$"
  },
  "global_flags": {
    "--json": {},
    "--config": {
      "arity": 1
    },
    "--verbose": {},
    "--quiet": {},
    "--yes": {
      "only": [
        "add",
        "cancel",
        "resolve"
      ]
    },
    "--actor": {
      "arity": 1,
      "pattern": "actor",
      "only": [
        "add",
        "cancel",
        "resolve"
      ]
    },
    "--decision-id": {
      "arity": 1,
      "repeat": true,
      "pattern": "decision_id",
      "max_count": 32,
      "only": [
        "add",
        "cancel",
        "resolve"
      ]
    },
    "--dry-run": {
      "only": [
        "add",
        "cancel",
        "resolve"
      ]
    }
  },
  "rules": [
    {
      "exclusive": [
        "--verbose",
        "--quiet"
      ]
    }
  ],
  "commands": {
    "add": {
      "double_dash": true,
      "double_dash_required": true,
      "flags": {
        "--queue": {
          "arity": 1,
          "pattern": "queue"
        },
        "--unique-key": {
          "arity": 1
        },
        "--priority": {
          "arity": 1,
          "pattern": "priority"
        },
        "--top": {},
        "--pin": {},
        "--cwd": {
          "arity": 1,
          "pattern": "abspath"
        },
        "--env": {
          "arity": 1,
          "repeat": true,
          "pattern": "env",
          "max_count": 256
        },
        "--pass-env": {
          "arity": 1,
          "repeat": true,
          "pattern": "envname",
          "max_count": 256
        },
        "--label": {
          "arity": 1,
          "repeat": true,
          "pattern": "label",
          "max_count": 32
        },
        "--timeout": {
          "arity": 1,
          "pattern": "duration_or_none"
        },
        "--max-retries": {
          "arity": 1,
          "pattern": "retries"
        },
        "--kill-grace": {
          "arity": 1,
          "pattern": "duration"
        },
        "--no-start": {},
        "--wait": {},
        "--wait-timeout": {
          "arity": 1,
          "pattern": "duration"
        }
      },
      "rules": [
        {
          "exclusive": [
            "--dry-run",
            "--wait"
          ]
        },
        {
          "when": [
            "--wait-timeout"
          ],
          "requires": [
            "--wait"
          ]
        }
      ]
    },
    "show": {
      "positionals": [
        {
          "name": "job",
          "pattern": "job",
          "optional": true
        }
      ],
      "flags": {
        "--unique-key": {
          "arity": 1
        },
        "--attempt": {
          "arity": 1,
          "pattern": "posint"
        },
        "--no-output": {}
      },
      "rules": [
        {
          "positional_xor_flag": {
            "positional": "job",
            "flag": "--unique-key"
          }
        }
      ]
    },
    "cancel": {
      "positionals": [
        {
          "name": "job",
          "pattern": "job",
          "optional": true
        }
      ],
      "flags": {
        "--queue": {
          "arity": 1,
          "pattern": "queue"
        },
        "--label": {
          "arity": 1,
          "repeat": true,
          "pattern": "label"
        },
        "--unique-key": {
          "arity": 1
        },
        "--all": {},
        "--force": {
          "human_only": true
        },
        "--wait-timeout": {
          "arity": 1,
          "pattern": "duration"
        }
      },
      "rules": [
        {
          "positional_or_any_flag": {
            "positional": "job",
            "flags": [
              "--queue",
              "--label",
              "--unique-key"
            ]
          }
        },
        {
          "positional_excludes_flags": {
            "positional": "job",
            "flags": [
              "--queue",
              "--label",
              "--unique-key",
              "--all"
            ]
          }
        },
        {
          "when": [
            "--all"
          ],
          "requires_any": [
            "--queue",
            "--label",
            "--unique-key"
          ]
        },
        {
          "when": [
            "--wait-timeout"
          ],
          "requires": [
            "--force"
          ]
        }
      ]
    },
    "resolve": {
      "positionals": [
        {
          "name": "job",
          "pattern": "job"
        }
      ],
      "flags": {
        "--as": {
          "arity": 1,
          "choices": [
            "done",
            "failed",
            "canceled"
          ]
        },
        "--note-file": {
          "arity": 1,
          "dash_ok": true
        }
      }
    }
  },
  "human_only_exit": 13
}
